# --- Railway provides this automatically when Postgres is attached ---
# DATABASE_URL=postgresql://...

# --- ChartMogul ---
CHARTMOGUL_API_KEY=

# --- Salesforce (read-only integration user via Connected App, client credentials flow) ---
SFDC_DOMAIN=https://healthie.my.salesforce.com
SFDC_CLIENT_ID=
SFDC_CLIENT_SECRET=

# Field API names — verify with `sf sobject describe -s Account` before first run
SFDC_ACCOUNT_ORG_ID_FIELD=Healthie_Org_ID__c
SFDC_ACCOUNT_STRIPE_ID_FIELD=Stripe_Customer_ID__c

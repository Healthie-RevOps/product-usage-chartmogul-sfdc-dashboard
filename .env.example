# --- Railway provides this automatically when Postgres is attached ---
# DATABASE_URL=postgresql://...

# --- ChartMogul ---
CHARTMOGUL_API_KEY=

# --- Salesforce (read-only integration user via Connected App, client credentials flow) ---
SFDC_DOMAIN=https://healthie.my.salesforce.com
SFDC_CLIENT_ID=
SFDC_CLIENT_SECRET=

# Field API names — verified 2026-09-02 via `sf sobject describe -s Account` (prod).
# Both are type string: Healthie_Org_ID__c (len 50), Stripe_Customer_ID__c (len 18).
SFDC_ACCOUNT_ORG_ID_FIELD=Healthie_Org_ID__c
SFDC_ACCOUNT_STRIPE_ID_FIELD=Stripe_Customer_ID__c
# Opportunities: all open ones, plus closed ones since this date
# SFDC_OPPS_CLOSED_SINCE=2024-01-01

# --- Sync schedule behaviour (sync service) ---
# ChartMogul refresh is incremental nightly (only customers with recent activity);
# full refresh weekly on this weekday (Mon=0 .. Sun=6; -1 = never) or with SYNC_FULL=1.
# SYNC_FULL_WEEKDAY=6
# SYNC_FULL=1
# SYNC_OVERLAP_DAYS=2

# --- Salesforce edits from the Accounts page (web service) ---
# Comma-separated emails allowed to edit the reference fields (Referenceable, Reference Date,
# Contracted to Case Study, Case Study Complete, Contracted to Use Logo). Unset = nobody;
# "*" = anyone signed in. Edits are logged in account_edits with the person's email.
# SFDC_EDITORS=you@gethealthie.com,stefanie@gethealthie.com

# --- Dashboard sign-in: Google, @gethealthie.com only (see app/auth.py) ---
# Required in prod: without it the app refuses to serve (fails closed).
SESSION_SECRET=
# Defaults: the shared Healthie internal-apps OAuth client, gethealthie.com.
# GOOGLE_CLIENT_ID=
# ALLOWED_EMAIL_DOMAIN=gethealthie.com
# Local dev without sign-in:
# ALLOW_INSECURE_NO_AUTH=1

# --- Machine access to /api/* only (HTTP Basic). Not accepted for pages or CSVs. ---
DASH_USER=
DASH_PASS=

# --- Salesforce fallback auth (used only if SFDC_CLIENT_ID/SECRET are blank) ---
SFDC_USERNAME=
SFDC_PASSWORD=
SFDC_SECURITY_TOKEN=

# --- Metabase (read-only API key; set on both Railway services) ---
METABASE_URL=https://visualize.gethealthie.com
METABASE_API_KEY=
# Local testing fallback only, never on Railway: browser cookie `metabase.SESSION`
# METABASE_SESSION=
# Saved question "Provider counts by Org" (org-level aggregates only; see sync/metabase.py)
# METABASE_PROVIDER_COUNTS_CARD=11966
# METABASE_CLIENT_COUNTS_CARD=11967
